{
  "version": 1,
  "sdk_version": "0.23.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ewnxnvtnkcexwzfnaawp.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "healthier-mcp",
      "version": "0.1.0",
      "title": "Healthier"
    },
    "tools": [
      {
        "name": "get_profile",
        "title": "Get my profile",
        "description": "Get the signed-in Healthier user's profile (full name, avatar).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "update_profile",
        "title": "Update my profile",
        "description": "Update the signed-in Healthier user's display name or avatar URL.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "full_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "New display name."
            },
            "avatar_url": {
              "type": "string",
              "format": "uri",
              "description": "New avatar image URL."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "health_info",
        "title": "General health information",
        "description": "Ask Healthier's medical assistant for general, non-emergency health information about a topic, symptom, or medication. Returns educational content only — never a diagnosis or prescription.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "topic": {
              "type": "string",
              "minLength": 2,
              "maxLength": 500,
              "description": "The health topic or question."
            }
          },
          "required": [
            "topic"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
